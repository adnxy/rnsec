{
  "expo": {
    "name": "demo",
    "ios": {
      "config": {
        "googleMapsApiKey": "fake-maps-key-123",
        "googleMobileAdsAppId": "ca-app-pub-0000000000000000~0000000000",
        "googleSignIn": { "apiKey": "fake-signin-key-1", "reservedClientId": "fake-reserved-1" },
        "branch": { "apiKey": "key_live_fakebranch1" },
